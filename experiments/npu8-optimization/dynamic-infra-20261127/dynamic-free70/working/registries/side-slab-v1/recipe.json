{
  "stage": [
    "side_tables",
    "partition_hints",
    "side_slab"
  ],
  "common": {
    "RECSYS_DYNAMIC_PARTITION": "1",
    "RECSYS_DYNAMIC_NORM": "1",
    "ACLNN_CACHE_LIMIT": "65536",
    "NPU_DYNAMIC_GROUPED_SIDE": "1",
    "NPU_DYNAMIC_ZERO_FLAT_HINTS": "1"
  },
  "A": {
    "NPU_DYNAMIC_SIDE_SLAB": "0"
  },
  "B": {
    "NPU_DYNAMIC_SIDE_SLAB": "1"
  },
  "activation": [
    {
      "file": "grouped_side_counts.json",
      "A": {
        "hits": "$steps",
        "fallbacks": 0
      },
      "B": {
        "hits": "$steps",
        "fallbacks": 0
      }
    },
    {
      "file": "zero_flat_hints.json",
      "A": {
        "validated": true,
        "enabled": true
      },
      "B": {
        "validated": true,
        "enabled": true
      }
    },
    {
      "file": "side_slab_counts.json",
      "A": {
        "disabled": 1
      },
      "B": {
        "installed": 1,
        "slab_forwards": "$steps",
        "dense_gradients": "$steps"
      }
    }
  ]
}
