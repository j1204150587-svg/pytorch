+bool d2dExperimentEnabled(const char* name)
+{
+    const char* value = std::getenv(name);
+    return value != nullptr && std::strcmp(value, "1") == 0;
+}
+
+bool validCopyExtent(const at::Tensor& tensor)
+{
+    const auto item_size = tensor.element_size();
+    const auto capacity = tensor.storage().nbytes() / item_size;
+    const auto offset = tensor.storage_offset();
+    return offset >= 0 && static_cast<uint64_t>(offset) <= capacity &&
+           static_cast<uint64_t>(tensor.numel()) <= capacity - offset;
+}
+
+bool matchesQueuedD2D(const at::Tensor& dst, const at::Tensor& src,
+                      const c10_npu::NPUStream& stream, bool allow_other_source, bool& other_source)
+{
+    const auto dtype = src.scalar_type();
+    if ((dtype != at::kBFloat16 && dtype != at::kFloat) || dtype != dst.scalar_type() ||
+        !src.sizes().equals(dst.sizes()) || src.numel() == 0 ||
+        src.is_neg() || dst.is_neg() || !src.is_contiguous() || !dst.is_contiguous() ||
+        FormatHelper::GetFormat(src) != ACL_FORMAT_ND || FormatHelper::GetFormat(dst) != ACL_FORMAT_ND ||
+        src.storage().unsafeGetStorageImpl() == dst.storage().unsafeGetStorageImpl() ||
+        !validCopyExtent(src) || !validCopyExtent(dst)) {
+        return false;
+    }
+    constexpr uintptr_t alignment = 64;
+    if (src.nbytes() % alignment != 0 ||
+        reinterpret_cast<uintptr_t>(src.data_ptr()) % alignment != 0 ||
+        reinterpret_cast<uintptr_t>(dst.data_ptr()) % alignment != 0) {
+        return false;
+    }
+    if (c10_npu::option::OptionsManager::GetTaskQueueEnable() != 1 ||
+        c10_npu::detail::isExternalStream(stream) || stream.isSyncLaunchStream() ||
+        c10_npu::currentStreamCaptureStatusMayInitCtx() != c10_npu::CaptureStatus::None) {
+        return false;
+    }
+    // The native allocator only reuses each block on its allocation stream.
+    // Queue publication precedes any later same-stream reuse. Foreign,
+    // shared-storage and cross-stream allocations keep the ACLNN contract.
+    const auto raw = stream.stream(false);
+    const auto& src_ptr = src.storage().data_ptr();
+    const auto& dst_ptr = dst.storage().data_ptr();
+    if (src_ptr.get() == dst_ptr.get()) return false;
+    using c10_npu::NPUCachingAllocator::CopyAllocationStream;
+    const auto src_stream = c10_npu::NPUCachingAllocator::copyAllocationStream(src_ptr, raw);
+    other_source = src_stream == CopyAllocationStream::Other;
+    return (src_stream == CopyAllocationStream::Same || (allow_other_source && other_source)) &&
+        c10_npu::NPUCachingAllocator::ownsCopyAllocationOnStream(dst_ptr, raw);
+}
