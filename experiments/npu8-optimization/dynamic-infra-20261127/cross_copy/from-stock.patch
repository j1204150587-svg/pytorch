 NpuCachingAllocator caching_allocator;
 
+CopyAllocationStream copyAllocationStream(const c10::DataPtr& data, aclrtStream raw)
+{
+    if (!data.get() || data.get_deleter() != &local_raw_delete || get() != &caching_allocator) {
+        return CopyAllocationStream::Invalid;
+    }
+    Block* block = caching_allocator.get_allocated_block(data.get());
+    if (!block) {
+        return CopyAllocationStream::Invalid;
+    }
+    if (block->stream == raw) {
+        return CopyAllocationStream::Same;
+    }
+    // Leave graph-private allocator/checkpoint lifetimes to the existing path.
+    return block->pool->owner_PrivatePool == nullptr ? CopyAllocationStream::Other : CopyAllocationStream::Invalid;
+}
+
+bool ownsCopyAllocationOnStream(const c10::DataPtr& data, aclrtStream raw)
+{
+    return copyAllocationStream(data, raw) == CopyAllocationStream::Same;
+}
+
+void recordOtherStreamCopySource(const c10::DataPtr& data, const c10_npu::NPUStream& stream)
+{
+    // The caller holds the source storage throughout publication.
+    Block* block = caching_allocator.get_allocated_block(data.get());
+    TORCH_INTERNAL_ASSERT(block != nullptr && get() == &caching_allocator);
+    caching_allocator.device_allocator[block->device]->protectCopyStream(block, stream);
+    // Canonical native record, including tracing, stream-use deduplication,
+    // allocator capture bookkeeping and the normal per-block free event.
+    caching_allocator.recordStream(data, stream);
+}
+
