+static const bool audit=flag("NPU_HSTU_REPEAT_ADD_COUNT");
+static const bool fault=flag("NPU_HSTU_REPEAT_ADD_TEST_REBIND_FAILURE");
+static std::atomic<uint64_t> counts[Length]{};
+static void count(Field f) { if (audit) counts[f].fetch_add(1,std::memory_order_relaxed); }
+extern "C" __attribute__((visibility("default"))) uint64_t npu_repeat_add_count(unsigned i) {
