+enum Field { Accepted, Fallback, NewPlan, Rebind, Work, Refused, BindFailure, OtherStream, SingleUse, Length };
+static const bool enabled=flag("NPU_HSTU_REPEAT_ADD");
+static const bool profile_toggle=flag("NPU_HSTU_REPEAT_ADD_PROFILE_TOGGLE");
