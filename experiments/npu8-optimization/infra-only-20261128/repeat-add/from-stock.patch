+        *this=Plan{};
+    }
+};
+struct Bank {
+    Api api;
+    std::mutex owner_lock,run_lock;
+    aclrtStream stream=nullptr;
+    int device=-1;
+    aclrtContext context=nullptr;
+    std::atomic<bool> disabled{false};
+    bool shutdown_registered=false;
+    std::array<Plan,84> plans{};
+    bool own(aclrtStream s,int dev) {
+        std::lock_guard<std::mutex> lock(owner_lock);
