+};
+static Report report;
+struct Input { at::Tensor x,y,out; aclrtStream stream; std::array<int,3> formats; };
+struct Plan {
+    aclOpExecutor* executor=nullptr;
+    std::array<aclTensor*,3> tensors{};
+    std::array<int,3> formats{};
+    aclScalar* alpha=nullptr;
+    void* workspace=nullptr;
+    uint64_t bytes=0;
+    bool retained=false;
+    void release(Api &api) {
