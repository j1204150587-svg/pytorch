+        // Stage 2 can fail after a partial submission. Propagate its status without retrying it.
+        NPU_CHECK_ERROR(rc,"execute repeated Add");
+        count(Work);
+        if (!p.retained) {
+            p.executor=nullptr;  // Single-use workspace queries give stage 2 ownership.
+            if (p.workspace) NPU_CHECK_ERROR(aclrtSynchronizeStream(v.stream),"complete single-use Add workspace");
+            p.release(api);
+        }
+        return rc;
+    }
+    int once(const Input &v) {
+        count(SingleUse);
+        Plan p;
+        prepare(p,v,false);
+        return submit_plan(p,v);
+    }
+    int consume(const Input &v) {
+        std::lock_guard<std::mutex> lock(run_lock);
+        if (c10_npu::check_dequeue_need_use(v.stream)) c10_npu::UseStreamResInCurrentThread(v.stream);
+        if (!shutdown_registered) {
+            NPU_CHECK_ERROR(aclrtGetCurrentContext(&context),"get Add owner context");
+            c10_npu::NpuSysCtrl::GetInstance().RegisterReleaseFn([this](){tear_down();},c10_npu::ReleasePriority::PriorityFirst);
+            shutdown_registered=true;
+        }
+        if (disabled.load()) return once(v);
+        auto &p=plans[(v.x.size(0)-1)*21+(v.x.size(1)-12)];
+        if (!p.executor) { prepare(p,v,true); return submit_plan(p,v); }
+        if (p.formats!=v.formats) return once(v);
+        bool ok=!fault;
+        const at::Tensor* values[]={&v.x,&v.y,&v.out};
+        for (size_t j=0;j<3 && ok;++j) {
+            auto bind=j==2?api.output:api.input;
+            ok=bind(p.executor,j==2?0:j,p.tensors[j],const_cast<void*>(values[j]->storage().data()))==0;
+        }
+        if (!ok) {
+            count(BindFailure);
+            disabled=true;
+            // No stage-2 submission for this request has occurred. Earlier asynchronous launches retain their plan.
+            return once(v);
+        }
+        count(Rebind);
+        return submit_plan(p,v);
+    }
+};
+static Bank &bank() { static Bank *state=new Bank; return *state; }
+static bool plain(const at::Tensor &t,int64_t b,int64_t l) {
+    return t.device().is_privateuseone() && t.scalar_type()==at::kBFloat16 && t.layout()==at::kStrided &&
+        t.dim()==3 && t.size(0)==b && t.size(1)==l && t.size(2)==64 && t.stride(2)==1 &&
+        t.stride(1)==64 && t.stride(0)==l*64 && t.storage_offset()==0 && !t.is_conj() && !t.is_neg() &&
+        t.storage().nbytes()==static_cast<size_t>(b*l*64*2) && t.storage().data() &&
+        reinterpret_cast<uintptr_t>(t.storage().data())%512==0 &&
+        t.storage().data_ptr().get_deleter()==c10_npu::NPUCachingAllocator::get()->raw_deleter() &&
+        at_npu::native::FormatHelper::IsOpInputBaseFormat(t) &&
+        typeid(*t.storage().unsafeGetStorageImpl())==typeid(torch_npu::NPUStorageImpl);
+}
+static bool submit(const at::Tensor &x,const at::Tensor &y,const at::Scalar &alpha,const at::Tensor &out) {
+    if (!enabled || (profile_toggle && profile_stock)) return false;
+    auto &state=bank();
+    if (x.dim()!=3 || x.size(0)<1 || x.size(0)>4 || x.size(1)<12 || x.size(1)>32 ||
+        alpha.type()!=at::kLong || alpha.toLong()!=1 || x.device()!=y.device() || x.device()!=out.device() ||
+        !plain(x,x.size(0),x.size(1)) || !plain(y,x.size(0),x.size(1)) || !plain(out,x.size(0),x.size(1)) ||
+        at::globalContext().deterministicAlgorithms() || c10_npu::is_core_control_enabled() ||
+        c10_npu::option::OptionsManager::GetTaskQueueEnable()!=1 || c10_npu::currentStreamCaptureStatus()!=c10_npu::CaptureStatus::None ||
+        !state.api.ready() || state.disabled.load()) { count(Fallback); return false; }
+    auto s=c10_npu::getCurrentNPUStream();
+    auto raw=s.stream(false);
+    if (s.device_index()!=x.get_device() || !state.own(raw,s.device_index())) { count(OtherStream); return false; }
+    if (c10_npu::check_enqueue_need_use(raw)) c10_npu::UseStreamResInCurrentThread(raw);
+    at_npu::native::SetDeterministic();
+    for (auto t:{&x,&y,&out}) c10_npu::NPUCachingAllocator::recordStream(t->storage().data_ptr(),s);
+    Input v{x,y,out,raw,{torch_npu::NPUBridge::GetNpuStorageImpl(x)->npu_desc_.npu_format_,
+                         torch_npu::NPUBridge::GetNpuStorageImpl(y)->npu_desc_.npu_format_,
+                         torch_npu::NPUBridge::GetNpuStorageImpl(out)->npu_desc_.npu_format_}};
+    count(Accepted);
+    at_npu::native::OpCommand::RunOpApiV2("aclnnAdd",[v](){return bank().consume(v);});
+    return true;
+}
+} // namespace repeat_add
