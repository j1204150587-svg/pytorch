+        return stream==s && device==dev;
+    }
+    void tear_down() {
+        std::lock_guard<std::mutex> guard(run_lock);
+        disabled=true;
+        aclrtContext prior=nullptr;
+        if (aclrtGetCurrentContext(&prior)!=0) prior=nullptr;
+        if (context!=prior) NPU_CHECK_ERROR(aclrtSetCurrentContext(context),"select Add owner context");
+        NPU_CHECK_ERROR(aclrtSynchronizeStream(stream),"drain repeated Add stream");
+        for (auto &p:plans) p.release(api);
+        if (prior && prior!=context) NPU_CHECK_ERROR(aclrtSetCurrentContext(prior),"restore Add owner context");
