+        p.tensors={ConvertType(v.x),ConvertType(v.y),ConvertType(v.out)};
+        p.alpha=ConvertType(at::Scalar(int64_t(1)));
+        TORCH_CHECK(p.tensors[0] && p.tensors[1] && p.tensors[2] && p.alpha,"Add descriptor creation failed");
+        NPU_CHECK_ERROR(api.prepare(p.tensors[0],p.tensors[1],p.alpha,p.tensors[2],&p.bytes,&p.executor),"prepare repeated Add");
+        TORCH_CHECK(p.executor,"missing Add executor");
+        if (keep) {
+            p.retained=api.keep(p.executor)==0;
+            if (!p.retained) { count(Refused); disabled=true; }
+        }
+        if (p.bytes) NPU_CHECK_ERROR(aclrtMalloc(&p.workspace,p.bytes,ACL_MEM_MALLOC_HUGE_FIRST),"allocate Add workspace");
+        count(NewPlan);
+    }
+    int submit_plan(Plan &p,const Input &v) {
