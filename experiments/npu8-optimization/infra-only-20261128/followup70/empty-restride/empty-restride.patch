+bool emptyAlreadyRestrided(c10::IntArrayRef size)
+{
+    static const bool enabled = [] {
+        const char *value = std::getenv("TORCH_NPU_EMPTY_SINGLE_RESTRIDE");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    // The special [0] case keeps TensorImpl's default geometry.
+    const bool skip = enabled && (size.size() != 1 || size[0] != 0);
+    static const bool audit = std::getenv("TORCH_NPU_EMPTY_STRIDE_AUDIT") &&
+        std::strcmp(std::getenv("TORCH_NPU_EMPTY_STRIDE_AUDIT"), "1") == 0;
+    if (audit) {
+        static struct Counts {
+            std::atomic<uint64_t> skipped{0}, kept{0};
+            ~Counts()
+            {
+                std::fprintf(stderr, "NPU_EMPTY_STRIDE skipped=%llu kept=%llu\n",
+                    static_cast<unsigned long long>(skipped.load()),
+                    static_cast<unsigned long long>(kept.load()));
+            }
+        } counts;
+        (skip ? counts.skipped : counts.kept).fetch_add(1, std::memory_order_relaxed);
+    }
+    return skip;
+}
 
