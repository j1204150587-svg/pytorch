+    size_t selected = 0;
+    for (size_t i = 0; i < blocks.size(); ++i) {
+        blocks[i].reset(::operator new(sizeof(Stream), std::nothrow));
+        if (!blocks[i]) break;
+        layoutCounters[3].fetch_add(1, std::memory_order_relaxed);
